# ── Hushh Tunnel Server — Environment Variables ──────────────────────────────

# Domain used for tunnels (subdomains are <id>.HUSHH_DOMAIN)
HUSHH_DOMAIN=hushh.online

# Server bind
HUSHH_HOST=0.0.0.0
HUSHH_PORT=8000

# Database URL (SQLite for dev, PostgreSQL for prod)
HUSHH_DATABASE_URL=sqlite+aiosqlite:///./hushh.db
# HUSHH_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/hushh

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
HUSHH_SECRET_KEY=changeme_generate_a_real_secret_key_here

# JWT settings
HUSHH_JWT_ALGORITHM=HS256
HUSHH_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Tunnel limits
HUSHH_MAX_TUNNELS_PER_USER=5
HUSHH_MAX_CONCURRENT_TUNNELS=500
HUSHH_MAX_REQUEST_SIZE_MB=50

# Timeouts (seconds)
HUSHH_HEARTBEAT_INTERVAL=15
HUSHH_HEARTBEAT_TIMEOUT=45
HUSHH_IDLE_TIMEOUT=28800        # 8 hours
HUSHH_REQUEST_TIMEOUT=30

# Logging
HUSHH_LOG_LEVEL=INFO
HUSHH_LOG_JSON=true

# Metrics
HUSHH_METRICS_ENABLED=true

# Admin (first user seeded on startup if DB is empty)
HUSHH_ADMIN_EMAIL=admin@hushh.online
HUSHH_ADMIN_PASSWORD=changeme_admin_password

# Cloudflare token — needed for Caddy wildcard TLS DNS challenge
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# SendGrid OTP Email settings
HUSHH_SENDGRID_API_KEY=your_sendgrid_api_key_here
HUSHH_SENDGRID_FROM_EMAIL=verified_sender@example.com
